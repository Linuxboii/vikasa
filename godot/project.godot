; Vikasa: Living Biome — Godot 4 client for the deterministic Python engine.
config_version=5

[application]
config/name="Vikasa · Living Biome"
run/main_scene="res://Main.tscn"
config/features=PackedStringArray("4.7", "GL Compatibility")
config/description="A living artificial-life biome: watch heredity, instinct and environment shape a population."
run/max_fps=0

[display]
window/size/viewport_width=1600
window/size/viewport_height=900
window/size/mode=2
window/size/window_width_override=1600
window/size/window_height_override=900
window/size/min_width=960
window/size/min_height=600
window/stretch/mode="disabled"

[rendering]
renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
textures/default_filters/use_nearest_mipmap_filter=false
environment/defaults/default_clear_color=Color(0.0352941, 0.0784314, 0.0705882, 1)
lights_and_shadows/directional_shadow/size=2048
lights_and_shadows/directional_shadow/soft_shadow_filter_quality=1
anti_aliasing/quality/screen_space_aa=1
